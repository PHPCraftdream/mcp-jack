    "set-admin-false": {
      "identity": "root",
      "fresh": true,
      "server_public_key": "server",
      "registry_overrides": {
        "alice": {
          "admin": true
        }
      },
      "args": {},
      "steps": [
        "Start with alice already admin=true and root still an active admin. As alice, call typed jack.whoami and assert kid, name and admin=true; as root, call typed jack.admin.user.set_admin with required admin=false and assert the returned alice entry; then authenticate again as alice with typed jack.whoami and assert admin=false. Report the full structuredContent returned by set_admin."
      ],
      "expected": {
        "outcome": "ok",
        "http_status": 200,
        "code": null,
        "data": {
          "structuredContent": {
            "kid": {
              "$kid": "alice"
            },
            "public_key": "kelVoYoxb3XSb-kFkOMEZNQ_x6GUFJNgdI2RjrsdgJE",
            "name": "alice",
            "admin": false,
            "not_before": null,
            "not_after": null
          }
        }
      },
      "source": "spec/03-user-management.md:set_admin required boolean and verified admin state transition"
    },
