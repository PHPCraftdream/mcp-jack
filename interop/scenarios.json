    "identity-forward": {
      "identity": "alice",
      "fresh": false,
      "server_public_key": "server",
      "args": {},
      "steps": [
        "Forward an ordinary app.identity MCP request with deliberately forged identity arguments and noncanonical JSON whitespace. The application handler must see the immutable verified alice identity and exactly the original request bytes, method, and target."
      ],
      "expected": {
        "outcome": "ok",
        "http_status": 200,
        "code": null,
        "data": {
          "content": [
            {
              "type": "text",
              "text": "identity"
            }
          ],
          "structuredContent": {
            "kid": {
              "$kid": "alice"
            },
            "name": "alice",
            "admin": false,
            "body_b64u": {
              "$base64url": " { \"jsonrpc\" : \"2.0\", \"id\" : 1, \"method\" : \"tools/call\", \"params\" : { \"name\" : \"app.identity\", \"arguments\" : { \"identity\" : { \"kid\" : \"forged\", \"name\" : \"root\", \"admin\" : true } } } }\n"
            },
            "method": "POST",
            "target": "/mcp"
          },
          "isError": false
        }
      },
      "source": "spec/02-authorization.md:verified application identity and exact request forwarding"
    },
    "identity-get": {
