    "app-permission-denied": {
      "identity": "root",
      "fresh": false,
      "server_public_key": "server",
      "args": {},
      "steps": [
        "Call ordinary MCP tool svc.config.set as protocol administrator root. The application handler denies root because protocol admin status does not grant this independent application permission."
      ],
      "expected": {
        "outcome": "rejected",
        "http_status": 403,
        "code": "application_permission_denied",
        "data": null
      },
      "source": "spec/02-authorization.md:ordinary MCP forwarding and app-owned authorization",
      "response_signature": "required"
    },
