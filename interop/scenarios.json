    "ping": {
      "identity": "alice",
      "fresh": false,
      "server_public_key": "server",
      "args": {},
      "steps": [
        "Sign and send a JSON-RPC ping; verify the signed response."
      ],
      "expected": {
        "outcome": "ok",
        "http_status": 200,
        "code": null,
        "data": {}
      },
      "source": "spec/fixtures/request-vectors.json:accept-ping"
    },
    "echo": {
      "identity": "alice",
      "fresh": false,
      "server_public_key": "server",
      "args": {
        "text": "grüß Gott – naïve café 日本語 🚀"
      },
      "steps": [
        "Sign a tools/call echo request with non-ASCII text; body hash and forwarded bytes must be unchanged."
      ],
      "expected": {
        "outcome": "ok",
        "http_status": 200,
        "code": null,
        "data": {
          "content": [
            {
              "type": "text",
              "text": "grüß Gott – naïve café 日本語 🚀"
            }
          ]
        }
      },
      "source": "spec/fixtures/request-vectors.json:accept-utf8-body; exact-byte forwarding"
    },
