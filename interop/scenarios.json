        "code": null,
        "data": {
          "structuredContent": {
            "kid": {
              "$kid": "alice"
            },
            "name": "alice",
            "admin": false,
            "body_b64u": "",
            "method": "GET",
            "target": "/identity?x=%2F"
          }
        }
      },
      "source": "spec/02-authorization.md:verified application identity and exact request forwarding"
    },
