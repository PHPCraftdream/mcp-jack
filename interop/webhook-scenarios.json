              "v1a": {
                "present": false,
                "count": 0,
                "valid": false
              },
              "v2a": {
                "present": false,
                "count": 0,
                "valid": false
              },
              "w1": {
                "present": false,
                "count": 0,
                "kid": null,
                "valid": false
              }
            },
            "body_equals": "event",
            "body_json": {
              "eventId": "evt_1",
              "name": "incident.created",
              "cursor": "cursor_xyz"
            }
          }
        ]
      }
    },
