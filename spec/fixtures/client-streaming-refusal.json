{
  "description": "Shared client streaming-refusal table. Manually maintained SDK client-side test table: not a protocol vector, not generated by spec/tools/gen-fixtures.mjs and not covered by its --check; edit by hand and keep the Go/Rust/TS runners in sync.",
  "policy": "all Content-Type field lines are joined with commas (the combined form a fetch client also sees) and split at commas; a response with any member whose media type (text before the first ';', SP and HTAB trimmed, compared ASCII case-insensitively) equals text/event-stream is refused as an unverifiable stream whatever the parameters or the combined value look like; everything else keeps normal verification.",
  "cases": [
    {"name": "refuse-event-stream", "content_type": ["text/event-stream"], "refused": true},
    {"name": "refuse-event-stream-uppercase", "content_type": ["TEXT/EVENT-STREAM"], "refused": true},
    {"name": "refuse-event-stream-charset", "content_type": ["text/event-stream; charset=utf-8"], "refused": true},
    {"name": "refuse-event-stream-space-before-param", "content_type": ["text/event-stream ; x"], "refused": true},
    {"name": "refuse-event-stream-empty-param", "content_type": ["text/event-stream;;"], "refused": true},
    {"name": "refuse-event-stream-leading-space", "content_type": [" text/event-stream"], "refused": true},
    {"name": "allow-json", "content_type": ["application/json"], "refused": false},
    {"name": "refuse-invalid-combined-value", "content_type": ["application/json, text/event-stream"], "refused": true},
    {"name": "refuse-member-with-parameter", "content_type": ["application/json, text/event-stream; charset=utf-8"], "refused": true},
    {"name": "allow-absent", "content_type": [], "refused": false},
    {"name": "refuse-first-of-two", "content_type": ["text/event-stream", "application/json"], "refused": true},
    {"name": "refuse-second-of-two", "content_type": ["application/json", "text/event-stream"], "refused": true},
    {"name": "allow-stream-token-inside-parameter", "content_type": ["application/json; x=text/event-stream"], "refused": false},
    {"name": "allow-stream-lookalike", "content_type": ["text/event-streams"], "refused": false},
    {"name": "allow-non-ascii-space-prefix", "content_type": ["\u00a0text/event-stream"], "refused": false}
  ]
}
